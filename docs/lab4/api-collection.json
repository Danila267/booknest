          "protocol": "https",
          "host": ["openlibrary", "org"],
          "path": ["search.json"],
          "query": [
            { "key": "q", "value": "booknest-no-matching-title-7f3a9c2e4b18d06a5c91", "description": "A long unlikely string that returns no docs." },
            { "key": "limit", "value": "20" },
            { "key": "page", "value": "1" },
            { "key": "fields", "value": "key,title,author_name,first_publish_year,cover_i,ebook_access,subject" }
          ]
        },
        "description": "Search a query that returns no docs."
      },
      "response": []
    },
